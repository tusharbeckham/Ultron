{
  "name": "ultron-cli",
  "version": "0.5.0",
  "description": "Dependency-free, model-agnostic developer CLI. Local-first chat, subagent DAG pipelines with explicit quality gates (gauntlet/v1), lifecycle hooks, remote MCP, OAuth, and resilient multi-provider routing. Zero runtime dependencies, no telemetry.",
  "keywords": [
    "cli",
    "llm",
    "agents",
    "subagents",
    "pipeline",
    "dag",
    "mcp",
    "local-first",
    "lm-studio",
    "ollama",
    "zero-dependency",
    "openai-compatible"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tusharbeckham/Ultron.git"
  },
  "type": "module",
  "bin": { "ultron": "./bin/ultron.mjs" },
  "files": ["bin","src","scripts","README.md","ARCHITECTURE.md","SECURITY.md","LICENSE","docs"],
  "scripts": { "test": "node --test --test-concurrency=1 --test-timeout=30000", "start": "node ./bin/ultron.mjs", "pack:check": "npm pack --dry-run" },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
